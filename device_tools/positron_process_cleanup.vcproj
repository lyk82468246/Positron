	<Platforms>
		<Platform Name="Windows Mobile 6 Professional SDK (ARMV4I)" />
	</Platforms>
	<ToolFiles />
	<Configurations>
		<Configuration Name="Debug|Windows Mobile 6 Professional SDK (ARMV4I)"
			OutputDirectory="bin\$(ConfigurationName)"
			IntermediateDirectory="bin\$(ConfigurationName)"
			ConfigurationType="1" CharacterSet="1">
			<Tool Name="VCPreBuildEventTool" />
			<Tool Name="VCCustomBuildTool" />
			<Tool Name="VCXMLDataGeneratorTool" />
			<Tool Name="VCWebServiceProxyGeneratorTool" />
			<Tool Name="VCMIDLTool" />
			<Tool Name="VCCLCompilerTool" ExecutionBucket="7" Optimization="0"
				PreprocessorDefinitions="_DEBUG;_WIN32_WCE=$(CEVER);UNDER_CE;$(PLATFORMDEFINES);WINCE;DEBUG;_WINDOWS;$(ARCHFAM);$(_ARCHFAM_);_UNICODE;UNICODE"
				MinimalRebuild="true" RuntimeLibrary="1" UsePrecompiledHeader="0"
				WarningLevel="3" DebugInformationFormat="3" CompileAs="1" />
