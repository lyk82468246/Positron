LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDR_APP_MENUBAR_ZH RCDATA
BEGIN
    IDR_APP_MENU_ZH,
    2,
    I_IMAGENONE, APP_CMD_TABS, TBSTATE_ENABLED,
        TBSTYLE_AUTOSIZE | TBSTYLE_DROPDOWN, IDS_APP_TABS_ZH, 0, 0,
    I_IMAGENONE, APP_CMD_MENU, TBSTATE_ENABLED,
        TBSTYLE_AUTOSIZE | TBSTYLE_DROPDOWN, IDS_APP_MENU_ZH, 0, 1,
END

IDR_APP_MENU_ZH MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "返回", APP_CMD_BACK, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "新标签页", APP_CMD_NEW_TAB
        MENUITEM SEPARATOR
        MENUITEM "刷新", APP_CMD_REFRESH
        MENUITEM "关闭标签页", APP_CMD_CLOSE_TAB
    END
    POPUP ""
    BEGIN
        MENUITEM "主页", APP_CMD_HOME
        MENUITEM "打开地址", APP_CMD_ADDRESS
        MENUITEM SEPARATOR
        MENUITEM "历史记录", APP_CMD_HISTORY
        MENUITEM "下载", APP_CMD_DOWNLOADS
        MENUITEM "设置", APP_CMD_SETTINGS
        MENUITEM "关于", APP_CMD_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "退出", APP_CMD_EXIT
    END
END

