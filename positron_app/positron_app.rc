#include "resource.h"
#include <windows.h>
#include <commctrl.h>
#include <aygshell.h>

#pragma code_page(65001)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_APP_MENUBAR_EN RCDATA
BEGIN
    IDR_APP_MENU_EN,
    2,
    I_IMAGENONE, APP_CMD_TABS, TBSTATE_ENABLED,
        TBSTYLE_AUTOSIZE | TBSTYLE_DROPDOWN, IDS_APP_TABS_EN, 0, 0,
    I_IMAGENONE, APP_CMD_MENU, TBSTATE_ENABLED,
        TBSTYLE_AUTOSIZE | TBSTYLE_DROPDOWN, IDS_APP_MENU_EN, 0, 1,
END

IDR_APP_MENU_EN MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Back", APP_CMD_BACK, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "New tab", APP_CMD_NEW_TAB
        MENUITEM SEPARATOR
        MENUITEM "Refresh", APP_CMD_REFRESH
        MENUITEM "Close tab", APP_CMD_CLOSE_TAB
    END
    POPUP ""
    BEGIN
        MENUITEM "Home", APP_CMD_HOME
        MENUITEM "Open Address", APP_CMD_ADDRESS
        MENUITEM SEPARATOR
        MENUITEM "History", APP_CMD_HISTORY
        MENUITEM "Downloads", APP_CMD_DOWNLOADS
        MENUITEM "Settings", APP_CMD_SETTINGS
        MENUITEM "About", APP_CMD_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Exit", APP_CMD_EXIT
    END
END

